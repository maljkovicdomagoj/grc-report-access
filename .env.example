# Supabase — auto-added by the Vercel Supabase integration (STORAGE_ prefix).
# Do not rename these in Vercel; the integration rewrites them on key rotation.
# The /api functions read these server-side.
STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_ANON_KEY=           # used server-side to verify user JWTs
STORAGE_SUPABASE_SERVICE_ROLE_KEY=   # server only — bypasses RLS (webhook writes)

# Stripe — add these manually in Vercel (the Supabase integration does not create them)
STRIPE_SECRET_KEY=                   # server only
STRIPE_PUBLISHABLE_KEY=              # safe in frontend
STRIPE_WEBHOOK_SECRET=               # server only

# Webflow — add these manually in Vercel
WEBFLOW_API_TOKEN=                   # server only
WEBFLOW_SITE_ID=63e17201c0e9876f45c22d5a

# Note: the Webflow frontend has no build step, so it cannot read Vercel env
# vars (incl. the NEXT_PUBLIC_* ones the integration added). Public values —
# Supabase URL + anon key, Stripe publishable key — are pasted directly into
# the Webflow embed JS.
